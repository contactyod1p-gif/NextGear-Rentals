# NextGear Rentals — Environment Configuration Template
# Copy this file to .env and fill in all values before running the server.
# NEVER commit the .env file to version control.

# ─────────────────────────────────────────────────
# DATABASE (Required)
# ─────────────────────────────────────────────────
# Full PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/nextgear

# ─────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Leave blank to allow all origins (development only — lock this down in production).
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─────────────────────────────────────────────────
# RUNTIME (Set automatically by the platform)
# ─────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=development
